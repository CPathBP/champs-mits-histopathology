    {"organ": "right_lung", "text_source": "site_report", "condition": "bronchopneumonia", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "bronchopneumonia", "negated": false},
    {"organ": "liver", "text_source": "cpl_slides", "condition": "steatosis", "severity": "severe", "extent": null, "modifiers": {"droplet": "mixed_droplet"}, "supporting_quote": "Severe small and large droplet steatosis", "negated": false},
    {"organ": "liver", "text_source": "cpl_slides", "condition": "hepatic_inflammation_portal", "severity": "mild", "extent": null, "modifiers": {"inflammation_character": "mononuclear_lymphocytic"}, "supporting_quote": "mild periportal lymphocytic inflammation", "negated": false},
    {"organ": "liver", "text_source": "cpl_slides", "condition": "cholestasis", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "cholestasis", "negated": false},
    {"organ": "liver", "text_source": "cpl_slides", "condition": "pigment_unspecified", "severity": "severe", "extent": null, "modifiers": {}, "supporting_quote": "abundant golden-brown pigment in Kupffer cells", "negated": false},
    {"organ": "right_lung", "text_source": "cpl_slides", "condition": "atelectasis", "severity": "mild", "extent": null, "modifiers": {}, "supporting_quote": "Mild atelectasis", "negated": false}
  ],
  "negations": [
    {"organ": "cns_post", "text_source": "site_report", "negation_group": "unremarkable", "supporting_quote": "CNS: unremarkable"},
    {"organ": "cns_trans", "text_source": "site_report", "negation_group": "unremarkable", "supporting_quote": "CNS: unremarkable"},
    {"organ": "cns_post", "text_source": "cpl_slides", "negation_group": "unremarkable", "supporting_quote": "Unremarkable"}
  ],
  "quality_flags": [
    {"organ": "liver",      "text_source": "cpl_review_of_scans", "flag": "no_scans_available", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "No site scanned slides available to be reviewed"},
    {"organ": "right_lung", "text_source": "cpl_review_of_scans", "flag": "no_scans_available", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "No site scanned slides available to be reviewed"},
    {"organ": "left_lung",  "text_source": "cpl_review_of_scans", "flag": "no_scans_available", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "No site scanned slides available to be reviewed"},
    {"organ": "cns_post",   "text_source": "cpl_review_of_scans", "flag": "no_scans_available", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "No site scanned slides available to be reviewed"},
    {"organ": "cns_trans",  "text_source": "cpl_review_of_scans", "flag": "no_scans_available", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "No site scanned slides available to be reviewed"},
    {"organ": "cns_post",   "text_source": "cpl_slides", "flag": "meninges_present", "severity": null, "extent": null, "modifiers": {}, "supporting_quote": "Meninges present"},
